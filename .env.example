# Names only. Fill real values in .env locally and in Railway → Variables. Never commit .env.

# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}.
# Local (docker-compose): postgresql://thousandhands:thousandhands@localhost:5432/thousandhands?schema=public
DATABASE_URL=
# Railway sets PORT automatically; only needed locally (defaults to 3000).
PORT=

APP_BASE_URL=
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0
WEBHOOK_VERIFY_TOKEN=

ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# 32 bytes, base64 or hex: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
ADMIN_PASSWORD=
# At least 32 chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

NOTIFY_WEBHOOK_URL=
TAKEOVER_PAUSE_HOURS=2

INVOICE_COMPANY_NAME=
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_UEN=
INVOICE_LOGO_URL=
GST_RATE=0.09
