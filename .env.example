# Local: matches docker-compose.yml. On Railway, use the Postgres plugin's DATABASE_URL.
DATABASE_URL=postgresql://thousandhands:thousandhands@localhost:5432/thousandhands?schema=public
PORT=3000
PUBLIC_BASE_URL=https://api.[YOUR_DOMAIN]

META_APP_ID=[APP_ID]
META_APP_SECRET=
META_CONFIG_ID=[CONFIGURATION_ID]
META_GRAPH_VERSION=v26.0

# Random string you choose; must match the Meta App Dashboard webhook config.
WEBHOOK_VERIFY_TOKEN=

# 32-byte key, base64 or hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

AI_API_KEY=
AI_MODEL=[AI_MODEL]
AI_TAKEOVER_PAUSE_MINUTES=120

ADMIN_PASSWORD=
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
